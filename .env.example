# Redis
REDIS_URL=redis://localhost:6379/0

# Modo de envio de e-mail
EMAIL_SENDER_MODE=smtp

# Configurações do servidor SMTP
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=usuario@example.com
SMTP_PASSWORD=supersecreta
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS=true
SMTP_DOMAIN=example.com

# Remetente dos e-mails
MAIL_FROM="Notificações <no-reply@example.com>"

# Painel do Sidekiq (opcional; sem credenciais, aberto apenas em desenvolvimento)
SIDEKIQ_WEB_USERNAME=admin
SIDEKIQ_WEB_PASSWORD=troque-esta-senha